use "std -> fs" from "fs"

;; job.h# — uruchamianie polecenia w TLE z odczytem wyniku z plików.
;;
;; Wzorzec jak w HackerOS-Updater/worker.h#: tui jest jednowątkowe, więc polecenie
;; działa w osobnej sesji (setsid), pisze do pliku `out` (stdout+stderr), a kod
;; wyjścia ląduje atomowo w pliku `rc`. Pętla UI co kilka ticków woła `finished`/`output`.

pub fn sq(s: string) -> string is
    return "'" + string_replace(s, "'", "'\\''") + "'"
end

;; Tworzy katalog zadania i startuje `cmd` (całość przez `<shell> -c`). Zwraca katalog.
pub fn start(shell_bin: string, cmd: string) -> string is
    let dir: string = string_trim(shell("umask 077; mktemp -d /tmp/hacker-interactive.XXXXXX"))
    if dir == "" is return "" end
    let runner: string = if string_ends_with(shell_bin, "bash") then shell_bin + " -c " + sq(cmd) else shell_bin + " -c " + sq(cmd)
    let script: string = "#!/bin/sh\n" +
        "echo $$ > " + sq(dir + "/pid") + "\n" +
        "TERM=xterm-256color " + runner + " > " + sq(dir + "/out") + " 2>&1 < /dev/null\n" +
        "echo $? > " + sq(dir + "/rc.tmp") + "\n" +
        "mv " + sq(dir + "/rc.tmp") + " " + sq(dir + "/rc") + "\n"
    fs::write(dir + "/job.sh", script)
    shell("( if command -v setsid >/dev/null 2>&1; then setsid sh " + sq(dir + "/job.sh") + "; else sh " + sq(dir + "/job.sh") + "; fi ) >/dev/null 2>&1 </dev/null &")
    return dir
end

pub fn finished(dir: string) -> bool is
    if dir == "" is return true end
    return file_exists(dir + "/rc")
end

;; Kod wyjścia (po `finished`); 1 gdy nieczytelny.
pub fn exit_code(dir: string) -> int is
    let t: string = string_trim(file_read(dir + "/rc"))
    if t == "" is return 1 end
    return str_to_int(t)
end

;; Dotychczasowe wyjście (ANSI i '\r' usunięte, żeby nie psuły układu).
pub fn output(dir: string) -> string is
    if dir == "" || !file_exists(dir + "/out") is return "" end
    return shell("sed -e 's/\\x1b\\[[0-9;?]*[a-zA-Z]//g' -e 's/.*\\r//' " + sq(dir + "/out") + " 2>/dev/null")
end

pub fn kill(dir: string) is
    if dir == "" is return end
    let pid: string = string_trim(file_read(dir + "/pid"))
    if pid != "" is
        shell("kill -TERM -- -" + pid + " 2>/dev/null || kill -TERM " + pid + " 2>/dev/null")
    end
end

pub fn cleanup(dir: string) is
    if dir != "" && string_starts_with(dir, "/tmp/hacker-interactive.") is
        shell("rm -rf " + sq(dir))
    end
end
