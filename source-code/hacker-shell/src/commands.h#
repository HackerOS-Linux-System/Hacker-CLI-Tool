;; Tytuly grup w kolejnosci wyswietlania.
pub fn group_titles() -> [string] is
    return ["📦 Pakiety", "📥 Unpack", "📤 Pack", "🐳 Env", "⚙️  System", "▶️  Run", "🔌 Pluginy", "🎨 Settings", "🔧 Narzędzia", "🖥️  Shell"]
end

;; Do ktorej grupy (indeks w group_titles) nalezy komenda.
pub fn group_of(cmd: string) -> int is
    if cmd == "install" || cmd == "remove" || cmd == "flatpak-install" || cmd == "flatpak-remove" is return 0 end
    if string_starts_with(cmd, "unpack ") is return 1 end
    if string_starts_with(cmd, "pack ") is return 2 end
    if string_starts_with(cmd, "env ") is return 3 end
    if cmd == "update" || cmd == "update --with-gui" || cmd == "system logs" || cmd == "switch hacker-mode" || cmd == "switch steam-gamemode" || cmd == "restart" || cmd == "doctor" is return 4 end
    if string_starts_with(cmd, "run ") is return 5 end
    if string_starts_with(cmd, "plugin ") is return 6 end
    if string_starts_with(cmd, "settings ") is return 7 end
    if cmd == "help" || cmd == "clear" || cmd == "exit" || cmd == "quit" is return 9 end
    ;; enable/disable motd w Pythonie nie nalezaly do zadnej grupy (nie byly w pomocy) — trafiaja do System
    if string_starts_with(cmd, "enable ") || string_starts_with(cmd, "disable ") is return 4 end
    return 8
end
