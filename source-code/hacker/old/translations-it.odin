package hackeros

it_translations :: proc() -> map[string]string {
    trans: map[string]string
    // Traduzioni da env
    trans["env_create_usage"] = "Uso: hacker env create <file.hk|file.yaml>"
    trans["env_remove_usage"] = "Uso: hacker env remove <nome>"
    trans["env_unknown_sub"] = "Sottocomando env sconosciuto:"
    trans["file_not_exists"] = "Il file non esiste:"
    trans["env_missing_fields"] = "Campi obbligatori name o image mancanti nel file di configurazione"
    trans["env_creating"] = "Creazione ambiente"
    trans["env_created"] = "Ambiente creato con successo!"
    trans["env_removed"] = "Ambiente rimosso."
    trans["env_list"] = "Elenco di tutti gli ambienti Hacker env:"
    trans["env_subcommands"] = "Sottocomandi env:"
    trans["env_create_desc"] = "Crea nuovo ambiente da file"
    trans["env_remove_desc"] = "Rimuovi ambiente"
    trans["env_enter_desc"] = "Entra nell'ambiente (con strumenti montati)"
    trans["env_docs_desc"] = "Tutorial completo + esempi"
    trans["env_settings_desc"] = "Elenca tutti gli ambienti"
    trans["env_docs"] = `
    %s=== Hacker env – tutorial completo ===%s
    1. Crea un file di configurazione (es. pentest.hk):
    [env]
    -> name => pentest-env
    -> image => fedora:latest
    -> shell => zsh
    [packages]
    -> -> nmap
    -> -> metasploit-framework
    -> -> burpsuite
    [sync_configs]
    -> -> ~/.zshrc
    -> -> ~/.config/nvim
    [sync_tools]
    -> snap => ["code"]
    -> flatpak => ["com.brave.Browser"]
    -> system => ["~/go/bin/gf"]
    2. Crea l'ambiente:
    hacker env create ./pentest.hk
    3. Entra:
    hacker env enter pentest-env
    4. Rimuovi:
    hacker env remove pentest-env
    Tutti gli ambienti sono normali container podman – puoi usare distrobox enter / podman exec normalmente.
    `
    // Traduzioni da main
    trans["usage_install"] = "Uso: hacker install <pacchetto>"
    trans["usage_remove"] = "Uso: hacker remove <pacchetto>"
    trans["usage_flatpak_install"] = "Uso: hacker flatpak-install <pacchetto>"
    trans["usage_flatpak_remove"] = "Uso: hacker flatpak-remove <pacchetto>"
    trans["usage_enter"] = "Uso: hacker enter <contenitore>"
    trans["usage_remove_container"] = "Uso: hacker remove-container <contenitore>"
    trans["usage_restart"] = "Uso: hacker restart <servizio>"
    trans["how_to_create1"] = "Per creare un comando personalizzato:"
    trans["how_to_create2"] = "Crea un file {nome-comando}.hacker in ~/.config/hackeros/hacker/custom-commands/"
    trans["how_to_create3"] = "Un file di esempio per comandi personalizzati si trova in: <https://github.com/HackerOS-Linux-System/Hacker-CLI-Tool/blob/main/hacker/config-files/custom-commands/example.hacker>"
    trans["version_tool"] = "Ultima versione dello strumento hacker: 2.3.1"
    trans["version_os"] = "Ultima versione di HackerOS: 4.5"
    trans["file_not_found"] = "File non trovato:"
    trans["variant_not_found"] = "Variante non trovata nel file."
    trans["no_exec_custom"] = "Nessun 'exec' nel file di comando personalizzato."
    trans["error_custom"] = "Errore durante l'elaborazione del comando personalizzato:"
    trans["unknown_command"] = "Comando sconosciuto:"
    trans["system_subcommands"] = "Sottocomandi system:"
    trans["logs_desc"] = "Mostra i log di sistema"
    trans["unknown_system"] = "Sottocomando system sconosciuto:"
    trans["unknown_update_flag"] = "Flag sconosciuto per update:"
    trans["available_flags"] = "Flag disponibili: --with-gui"
    trans["tools_index"] = "Indice strumenti HackerOS:"
    trans["tool_bit"] = "gestore pacchetti per HackerScript - più avanzato"
    trans["tool_virus"] = "gestore pacchetti per HackerScript"
    trans["tool_bytes"] = "gestore pacchetti per Hacker Lang"
    trans["tool_hl"] = "interprete/compilatore per script in Hacker Lang"
    trans["tool_hackerc"] = "compilatore per HackerScript"
    trans["tool_hacker"] = "strumento CLI principale di HackerOS"
    trans["tool_kernel"] = "kernel HackerOS; se vuoi contribuire, contattaci a: gmail - <hackeros068@gmail.com> o <https://github.com/orgs/HackerOS-Linux-System/discussions>"
    trans["tool_steam"] = "contenitore per Steam"
    trans["tool_welcome"] = "app di benvenuto HackerOS"
    trans["tool_app"] = "app HackerOS per telefoni"
    trans["tool_hacker_mode"] = "modalità gioco ispirata a steamos gamemode"
    trans["tool_isolator"] = "strumento CLI per installare pacchetti dal repository in container podman"
    trans["tool_hpm"] = "gestore pacchetti della community"
    trans["tool_game_mode"] = "modalità gioco ispirata ad ASUS Armoury Crate"
    trans["tool_hup"] = "sistema di aggiornamenti automatici"
    trans["tool_hammer"] = "sistema di installazione/aggiornamento atomico dei pacchetti (usato solo nell'edizione atomic)"
    trans["tool_games"] = "GUI per avviare giochi: starblaster, bit-jump, bark squadron, the racer"
    trans["tool_cockpit"] = "centro di controllo del sistema nel browser"
    trans["tool_launcher"] = "avvia giochi exe con questa app"
    trans["tool_lpm"] = "Successore di apt"
    trans["tool_hedit"] = "editor di testo ispirato a nano"
    trans["tool_ngt"] = "strumento moderno ispirato a mc"
    trans["tool_hbuild"] = "equivalente moderno di cmake/meson"
    trans["tool_hackerdeck"] = "overlay per waydroid"
    trans["tool_hackerterm"] = "Terminale per HackerOS"
    trans["tool_store"] = "Negozio HackerOS"
    trans["tool_hsh"] = "shell propria (può sostituire zsh/bash)"
    trans["tool_getit"] = "strumento CLI per scaricare directory da github/gitlab. Può sostituire wget/curl e git"
    trans["tool_builder"] = "overlay per live build"
    trans["tool_hexai"] = "IA per HackerOS (richiede hardware potente)"
    trans["tool_chker"] = "strumento per cambiare il kernel con versioni personalizzate"
    trans["tool_anvil"] = "strumento CLI per gestire un sistema in sola lettura (usato solo nell'edizione atomic)"
    trans["tool_blue"] = "se vuoi aiutare a sviluppare l'ambiente grafico HackerOS, contattaci a gmail - <hackeros068@gmail.com> o <https://github.com/orgs/HackerOS-Linux-System/discussions>"

    trans["plugins"] = "Plugin:"
    trans["enabled"] = "abilitato"
    trans["disabled"] = "disabilitato"
    trans["invalid"] = "non valido"
    trans["usage_plugin_enable"] = "Uso: hacker plugin enable <nome-plugin>"
    trans["plugin_not_found"] = "Plugin non trovato:"
    trans["enabled_plugin"] = "Plugin abilitato"
    trans["usage_plugin_disable"] = "Uso: hacker plugin disable <nome-plugin>"
    trans["disabled_plugin"] = "Plugin disabilitato"
    trans["unknown_plugin"] = "Sottocomando plugin sconosciuto:"
    trans["plugin_subcommands"] = "Sottocomandi plugin:"
    trans["list_desc"] = "Mostra tutti i plugin e il loro stato"
    trans["enable_desc"] = "Abilita plugin"
    trans["disable_desc"] = "Disabilita plugin"
    trans["enabled_motd"] = "MOTD abilitato."
    trans["enabled_special_motd"] = "MOTD speciale abilitato."
    trans["unknown_enable"] = "Sottocomando enable sconosciuto:"
    trans["enable_subcommands"] = "Sottocomandi enable:"
    trans["motd_desc"] = "Abilita MOTD standard"
    trans["special_motd_desc"] = "Abilita MOTD speciale"
    trans["disabled_motd"] = "MOTD disabilitato."
    trans["unknown_disable"] = "Sottocomando disable sconosciuto:"
    trans["disable_subcommands"] = "Sottocomandi disable:"
    trans["current_language"] = "Lingua corrente:"
    trans["language_set"] = "Lingua impostata su"
    trans["unsupported_language"] = "Lingua non supportata:"
    trans["supported"] = "Lingue supportate:"
    trans["unknown_settings"] = "Sottocomando settings sconosciuto:"
    trans["settings_subcommands"] = "Sottocomandi settings:"
    trans["language_desc"] = "Imposta o mostra la lingua (es. pl, en)"
    trans["tool_title"] = "Strumento HackerOS - Comandi disponibili:"
    trans["desc_unpack"] = "Estrai e installa vari componenti (usa 'hacker unpack' per i sottocomandi)"
