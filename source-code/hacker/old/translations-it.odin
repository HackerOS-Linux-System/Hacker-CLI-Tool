    trans["desc_disable"] = "Disabilita funzionalità (usa 'hacker disable' per i sottocomandi)"
    trans["desc_how_to"] = "Mostra come creare comandi personalizzati"
    trans["desc_index"] = "Mostra indice di tutti gli strumenti HackerOS"
    trans["desc_info"] = "Mostra versioni dello strumento e di HackerOS"
    trans["desc_issue"] = "Apri una nuova segnalazione su GitHub nel browser (preferisce Vivaldi)"
    trans["desc_repair"] = "Ripara il sistema HackerOS"
    trans["desc_settings"] = "Impostazioni dello strumento (usa 'hacker settings' per i sottocomandi)"
