package hackeros

zh_translations :: proc() -> map[string]string {
    trans: map[string]string
    // 来自 env 的翻译
    trans["env_create_usage"] = "用法：hacker env create <文件.hk|文件.yaml>"
    trans["env_remove_usage"] = "用法：hacker env remove <名称>"
    trans["env_unknown_sub"] = "未知的 env 子命令："
    trans["file_not_exists"] = "文件不存在："
    trans["env_missing_fields"] = "配置文件中缺少必需的 name 或 image 字段"
    trans["env_creating"] = "正在创建环境"
    trans["env_created"] = "环境创建成功！"
    trans["env_removed"] = "环境已删除。"
    trans["env_list"] = "所有 Hacker env 环境列表："
    trans["env_subcommands"] = "env 子命令："
    trans["env_create_desc"] = "从文件创建新环境"
    trans["env_remove_desc"] = "删除环境"
    trans["env_enter_desc"] = "进入环境（带有挂载的工具）"
    trans["env_docs_desc"] = "完整教程 + 示例"
    trans["env_settings_desc"] = "列出所有环境"
    trans["env_docs"] = `
    %s=== Hacker env – 完整教程 ===%s
    1. 创建配置文件（例如 pentest.hk）：
    [env]
    -> name => pentest-env
    -> image => fedora:latest
    -> shell => zsh
    [packages]
    -> -> nmap
    -> -> metasploit-framework
    -> -> burpsuite
    [sync_configs]
    -> -> ~/.zshrc
    -> -> ~/.config/nvim
    [sync_tools]
    -> snap => ["code"]
    -> flatpak => ["com.brave.Browser"]
    -> system => ["~/go/bin/gf"]
    2. 创建环境：
    hacker env create ./pentest.hk
    3. 进入：
    hacker env enter pentest-env
    4. 删除：
    hacker env remove pentest-env
    所有环境都是普通的 podman 容器 – 你可以正常使用 distrobox enter / podman exec。
    `
    // 来自 main 的翻译
    trans["usage_install"] = "用法：hacker install <软件包>"
    trans["usage_remove"] = "用法：hacker remove <软件包>"
    trans["usage_flatpak_install"] = "用法：hacker flatpak-install <软件包>"
    trans["usage_flatpak_remove"] = "用法：hacker flatpak-remove <软件包>"
    trans["usage_enter"] = "用法：hacker enter <容器>"
    trans["usage_remove_container"] = "用法：hacker remove-container <容器>"
    trans["usage_restart"] = "用法：hacker restart <服务>"
    trans["how_to_create1"] = "要创建自定义命令："
