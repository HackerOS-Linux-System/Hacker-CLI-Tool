package hackeros

ru_translations :: proc() -> map[string]string {
    trans: map[string]string
    // Переводы из env
    trans["env_create_usage"] = "Использование: hacker env create <файл.hk|файл.yaml>"
    trans["env_remove_usage"] = "Использование: hacker env remove <имя>"
    trans["env_unknown_sub"] = "Неизвестная подкоманда env:"
    trans["file_not_exists"] = "Файл не существует:"
    trans["env_missing_fields"] = "Отсутствуют обязательные поля name или image в файле конфигурации"
    trans["env_creating"] = "Создание окружения"
    trans["env_created"] = "Окружение успешно создано!"
    trans["env_removed"] = "Окружение удалено."
    trans["env_list"] = "Список всех окружений Hacker env:"
    trans["env_subcommands"] = "Подкоманды env:"
    trans["env_create_desc"] = "Создать новое окружение из файла"
    trans["env_remove_desc"] = "Удалить окружение"
    trans["env_enter_desc"] = "Войти в окружение (с подключёнными инструментами)"
    trans["env_docs_desc"] = "Полный учебник + примеры"
    trans["env_settings_desc"] = "Список всех окружений"
    trans["env_docs"] = `
    %s=== Hacker env – полное руководство ===%s
    1. Создайте файл конфигурации (например, pentest.hk):
    [env]
    -> name => pentest-env
    -> image => fedora:latest
    -> shell => zsh
    [packages]
    -> -> nmap
    -> -> metasploit-framework
    -> -> burpsuite
    [sync_configs]
    -> -> ~/.zshrc
    -> -> ~/.config/nvim
    [sync_tools]
    -> snap => ["code"]
    -> flatpak => ["com.brave.Browser"]
    -> system => ["~/go/bin/gf"]
    2. Создайте окружение:
    hacker env create ./pentest.hk
    3. Войдите:
    hacker env enter pentest-env
    4. Удалите:
    hacker env remove pentest-env
    Все окружения – обычные контейнеры podman; вы можете использовать distrobox enter / podman exec как обычно.
    `
    // Переводы из main
    trans["usage_install"] = "Использование: hacker install <пакет>"
    trans["usage_remove"] = "Использование: hacker remove <пакет>"
    trans["usage_flatpak_install"] = "Использование: hacker flatpak-install <пакет>"
    trans["usage_flatpak_remove"] = "Использование: hacker flatpak-remove <пакет>"
    trans["usage_enter"] = "Использование: hacker enter <контейнер>"
    trans["usage_remove_container"] = "Использование: hacker remove-container <контейнер>"
    trans["usage_restart"] = "Использование: hacker restart <служба>"
    trans["how_to_create1"] = "Чтобы создать пользовательскую команду:"
    trans["how_to_create2"] = "Создайте файл {имя-команды}.hacker в ~/.config/hackeros/hacker/custom-commands/"
    trans["how_to_create3"] = "Пример файла пользовательской команды можно найти по адресу: <https://github.com/HackerOS-Linux-System/Hacker-CLI-Tool/blob/main/hacker/config-files/custom-commands/example.hacker>"
    trans["version_tool"] = "Последняя версия инструмента hacker: 2.3.1"
    trans["version_os"] = "Последняя версия HackerOS: 4.5"
    trans["file_not_found"] = "Файл не найден:"
    trans["variant_not_found"] = "Вариант не найден в файле."
    trans["no_exec_custom"] = "Нет 'exec' в файле пользовательской команды."
    trans["error_custom"] = "Ошибка обработки пользовательской команды:"
    trans["unknown_command"] = "Неизвестная команда:"
    trans["system_subcommands"] = "Подкоманды system:"
    trans["logs_desc"] = "Показать системные логи"
    trans["unknown_system"] = "Неизвестная подкоманда system:"
    trans["unknown_update_flag"] = "Неизвестный флаг для update:"
    trans["available_flags"] = "Доступные флаги: --with-gui"
    trans["tools_index"] = "Индекс инструментов HackerOS:"
    trans["tool_bit"] = "менеджер пакетов для HackerScript - более продвинутый"
    trans["tool_virus"] = "менеджер пакетов для HackerScript"
    trans["tool_bytes"] = "менеджер пакетов для Hacker Lang"
    trans["tool_hl"] = "интерпретатор/компилятор для скриптов на Hacker Lang"
    trans["tool_hackerc"] = "компилятор для HackerScript"
    trans["tool_hacker"] = "основной CLI-инструмент HackerOS"
    trans["tool_kernel"] = "ядро HackerOS; если вы хотите участвовать в разработке, свяжитесь по gmail - <hackeros068@gmail.com> или <https://github.com/orgs/HackerOS-Linux-System/discussions>"
    trans["tool_steam"] = "контейнер для Steam"
    trans["tool_welcome"] = "приветственное приложение HackerOS"
    trans["tool_app"] = "приложение HackerOS для телефонов"
    trans["tool_hacker_mode"] = "игровой режим, вдохновлённый steamos gamemode"
    trans["tool_isolator"] = "CLI-инструмент для установки пакетов из репозитория в контейнеры podman"
    trans["tool_hpm"] = "менеджер пакетов сообщества"
    trans["tool_game_mode"] = "игровой режим, вдохновлённый ASUS Armoury Crate"
