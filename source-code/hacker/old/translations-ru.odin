    trans["tool_blue"] = "если вы хотите помочь в разработке графической среды HackerOS, свяжитесь по gmail - <hackeros068@gmail.com> или <https://github.com/orgs/HackerOS-Linux-System/discussions>"

    trans["plugins"] = "Плагины:"
