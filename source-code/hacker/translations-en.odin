package hackeros

en_translations :: proc() -> map[string]string {
    trans: map[string]string
    // Translations from env
    trans["env_create_usage"] = "Usage: hacker env create <file.hk|file.yaml>"
    trans["env_remove_usage"] = "Usage: hacker env remove <name>"
    trans["env_unknown_sub"] = "Unknown env subcommand:"
    trans["file_not_exists"] = "File does not exist:"
    trans["env_missing_fields"] = "Missing required fields name or image in config file"
    trans["env_creating"] = "Creating environment"
    trans["env_created"] = "Environment created successfully!"
    trans["env_removed"] = "Environment has been removed."
    trans["env_list"] = "List of all Hacker env environments:"
    trans["env_subcommands"] = "Env subcommands:"
    trans["env_create_desc"] = "Create new environment from file"
    trans["env_remove_desc"] = "Remove environment"
    trans["env_enter_desc"] = "Enter environment (with mounted tools)"
    trans["env_docs_desc"] = "Full tutorial + examples"
    trans["env_settings_desc"] = "List all environments"
    trans["env_docs"] = `
    %s=== Hacker env – full tutorial ===%s
    1. Create a config file (e.g., pentest.hk):
    [env]
    -> name => pentest-env
    -> image => fedora:latest
    -> shell => zsh
    [packages]
    -> -> nmap
    -> -> metasploit-framework
    -> -> burpsuite
    [sync_configs]
    -> -> ~/.zshrc
    -> -> ~/.config/nvim
    [sync_tools]
    -> snap => ["code"]
    -> flatpak => ["com.brave.Browser"]
    -> system => ["~/go/bin/gf"]
    2. Create environment:
    hacker env create ./pentest.hk
    3. Enter:
    hacker env enter pentest-env
    4. Remove:
    hacker env remove pentest-env
    All environments are normal podman containers – you can use distrobox enter / podman exec normally.
    `
    // Translations from main
    trans["usage_install"] = "Usage: hacker install <package>"
    trans["usage_remove"] = "Usage: hacker remove <package>"
    trans["usage_flatpak_install"] = "Usage: hacker flatpak-install <package>"
    trans["usage_flatpak_remove"] = "Usage: hacker flatpak-remove <package>"
    trans["usage_enter"] = "Usage: hacker enter <container>"
    trans["usage_remove_container"] = "Usage: hacker remove-container <container>"
    trans["usage_restart"] = "Usage: hacker restart <service>"
    trans["how_to_create1"] = "To create a custom command:"
    trans["how_to_create2"] = "Create a file {command-name}.hacker in ~/.config/hackeros/hacker/custom-commands/"
    trans["how_to_create3"] = "Sample custom command file can be found at: <https://github.com/HackerOS-Linux-System/Hacker-CLI-Tool/blob/main/hacker/config-files/custom-commands/example.hacker>"
    trans["version_tool"] = "Latest version of hacker tool: 2.3.1"
    trans["version_os"] = "Latest version of HackerOS: 4.5"
    trans["file_not_found"] = "File not found:"
    trans["variant_not_found"] = "Variant not found in file."
    trans["no_exec_custom"] = "No 'exec' in custom command file."
    trans["error_custom"] = "Error processing custom command:"
    trans["unknown_command"] = "Unknown command:"
    trans["system_subcommands"] = "System subcommands:"
    trans["logs_desc"] = "Display system logs"
    trans["unknown_system"] = "Unknown system subcommand:"
    trans["unknown_update_flag"] = "Unknown flag for update:"
    trans["available_flags"] = "Available flags: --with-gui"
    trans["tools_index"] = "HackerOS Tools Index:"
    trans["tool_bit"] = "package manager for HackerScript - more advanced"
    trans["tool_virus"] = "package manager for HackerScript"
    trans["tool_bytes"] = "package manager for Hacker Lang"
    trans["tool_hl"] = "interpreter/compiler for scripts written in Hacker Lang"
    trans["tool_hackerc"] = "compiler for HackerScript"
    trans["tool_hacker"] = "main HackerOS CLI tool"
    trans["tool_kernel"] = "HackerOS kernel; if you want to develop, contact at: gmail - <hackeros068@gmail.com> or <https://github.com/orgs/HackerOS-Linux-System/discussions>"
    trans["tool_steam"] = "container for Steam"
    trans["tool_welcome"] = "HackerOS welcome app"
    trans["tool_app"] = "HackerOS app for phones"
    trans["tool_hacker_mode"] = "game mode inspired by steamos gamemode"
    trans["tool_isolator"] = "CLI tool to install packages from repository in podman containers"
    trans["tool_hpm"] = "community package manager"
    trans["tool_game_mode"] = "game mode inspired by ASUS Armoury Crate"
    trans["tool_hup"] = "automatic updates system"
    trans["tool_hammer"] = "atomic package installation/update system (used only in atomic edition)"
    trans["tool_games"] = "GUI for launching games: starblaster, bit-jump, bark squadron, the racer"
    trans["tool_cockpit"] = "system control center in the browser"
    trans["tool_launcher"] = "launch exe games with this app"
    trans["tool_lpm"] = "Successor of apt"
    trans["tool_hedit"] = "text editor inspired by nano"
    trans["tool_ngt"] = "modern tool inspired by mc"
    trans["tool_hbuild"] = "modern equivalent of cmake/meson"
    trans["tool_hackerdeck"] = "overlay for waydroid"
    trans["tool_hackerterm"] = "Terminal for HackerOS"
    trans["tool_store"] = "HackerOS Store"
    trans["tool_hsh"] = "own shell (can replace zsh/bash)"
    trans["tool_getit"] = "CLI tool to download directories from github/gitlab. Can also replace wget/curl and git"
    trans["tool_builder"] = "overlay for live build"
    trans["tool_hexai"] = "AI for HackerOS (requires powerful hardware)"
    trans["tool_chker"] = "tool to change the kernel to custom versions"
    trans["tool_anvil"] = "CLI tool to manage a read-only system (used only in atomic edition)"
    trans["tool_blue"] = "if you want to help develop HackerOS graphical environment, contact at gmail - <hackeros068@gmail.com> or <https://github.com/orgs/HackerOS-Linux-System/discussions>"

    trans["plugins"] = "Plugins:"
    trans["enabled"] = "enabled"
    trans["disabled"] = "disabled"
    trans["invalid"] = "invalid"
    trans["usage_plugin_enable"] = "Usage: hacker plugin enable <plugin-name>"
    trans["plugin_not_found"] = "Plugin not found:"
    trans["enabled_plugin"] = "Enabled plugin"
    trans["usage_plugin_disable"] = "Usage: hacker plugin disable <plugin-name>"
    trans["disabled_plugin"] = "Disabled plugin"
    trans["unknown_plugin"] = "Unknown plugin subcommand:"
    trans["plugin_subcommands"] = "Plugin subcommands:"
    trans["list_desc"] = "Display all plugins and their status"
    trans["enable_desc"] = "Enable plugin"
    trans["disable_desc"] = "Disable plugin"
    trans["enabled_motd"] = "Enabled MOTD."
    trans["enabled_special_motd"] = "Enabled special MOTD."
    trans["unknown_enable"] = "Unknown enable subcommand:"
    trans["enable_subcommands"] = "Enable subcommands:"
    trans["motd_desc"] = "Enable standard MOTD"
    trans["special_motd_desc"] = "Enable special MOTD"
    trans["disabled_motd"] = "Disabled MOTD."
    trans["unknown_disable"] = "Unknown disable subcommand:"
    trans["disable_subcommands"] = "Disable subcommands:"
    trans["current_language"] = "Current language:"
    trans["language_set"] = "Set language to"
    trans["unsupported_language"] = "Unsupported language:"
    trans["supported"] = "Supported languages:"
    trans["unknown_settings"] = "Unknown settings subcommand:"
    trans["settings_subcommands"] = "Settings subcommands:"
    trans["language_desc"] = "Set or display language (e.g., pl, en)"
    trans["tool_title"] = "HackerOS Tool - Available commands:"
    trans["desc_unpack"] = "Unpack and install various components (use 'hacker unpack' for subcommands)"
    trans["desc_pack"] = "Pack and remove various components (use 'hacker pack' for subcommands)"
    trans["desc_env"] = "Manage environments (use 'hacker env' for subcommands)"
    trans["desc_help"] = "Show this help"
    trans["desc_help_ui"] = "Show help in UI"
    trans["desc_docs"] = "Show documentation"
    trans["desc_install"] = "Install package using apt-frontend"
    trans["desc_remove"] = "Remove package using apt-frontend"
    trans["desc_flatpak_install"] = "Install Flatpak package"
    trans["desc_flatpak_remove"] = "Remove Flatpak package"
    trans["desc_system"] = "System-related commands (use 'hacker system' for subcommands)"
    trans["desc_run"] = "Run scripts and tools (use 'hacker run' for subcommands)"
    trans["desc_update"] = "Run HackerOS updater (with optional flags)"
    trans["desc_game"] = "Play text-based game"
    trans["desc_hacker_lang"] = "Information about hacker programming language"
    trans["desc_ascii"] = "Display ASCII art"
    trans["desc_shell"] = "Run hacker shell"
    trans["desc_enter"] = "Enter Distrobox container"
    trans["desc_remove_container"] = "Remove Distrobox container"
    trans["desc_restart"] = "Restart system service"
    trans["desc_plugin"] = "Manage plugins (use 'hacker plugin' for subcommands)"
    trans["desc_enable"] = "Enable features (use 'hacker enable' for subcommands)"
    trans["desc_disable"] = "Disable features (use 'hacker disable' for subcommands)"
    trans["desc_how_to"] = "Show how to create custom commands"
    trans["desc_index"] = "Show index of all HackerOS tools"
    trans["desc_info"] = "Show tool and HackerOS versions"
    trans["desc_issue"] = "Open new issue on GitHub in browser (prefers Vivaldi)"
    trans["desc_repair"] = "Repair HackerOS system"
    trans["desc_settings"] = "Tool settings (use 'hacker settings' for subcommands)"
    trans["desc_switch"] = "Switch between modes (hacker-mode, steam-gamemode)"
    trans["custom_commands"] = "Custom commands:"
    trans["no_description"] = "No description"
    trans["invalid_config"] = "Invalid configuration"
    trans["plugins_title"] = "Commands from plugins:"
    trans["hacker_lang_info1"] = "To use hacker programming language for files/scripts with .hacker extension,"
    trans["hacker_lang_info2"] = "use \"hl\" command and \"bytes\" for downloading dependencies, to compile or run them."

    // Translations from unpack
    trans["unpack_downloading"] = "Downloading"
    trans["unpack_done"] = "Installation completed."
    trans["unpack_blackarch_info1"] = "Install all BlackArch tools inside container."
    trans["unpack_blackarch_info2"] = "Enter container using: hacker enter blackarch"
    trans["unpack_roblox_done"] = "Installed Roblox support."
    trans["unpack_alacritty_done"] = "Alacritty configuration successfully installed in ~/.config/alacritty/alacritty.toml"
    trans["unpack_hydra_warning"] = "Note: Hydra look-and-feel may require manual configuration."
    trans["unpack_unknown"] = "Unknown unpack subcommand:"
    trans["unpack_title"] = "Unpack subcommands:"
    trans["unpack_add_ons"] = "Install wine and related tools"
    trans["unpack_gs"] = "Install gaming and cybersecurity"
    trans["unpack_devtools"] = "Install developer tools"
    trans["unpack_emulators"] = "Install emulators"
    trans["unpack_cybersecurity"] = "Set up BlackArch container"
    trans["unpack_select"] = "Run hacker-select"
    trans["unpack_gaming"] = "Install gaming tools"
    trans["unpack_gaming_roblox"] = "Install gaming with Roblox support"
    trans["unpack_hacker_mode"] = "Install game mode inspired by steam gamepadui"
    trans["unpack_gamescope"] = "Set up gamescope session for Steam"
    trans["unpack_auto_updates"] = "Enable automatic updates"
    trans["unpack_alacritty"] = "Install Alacritty configuration (copies alacritty.toml to ~/.config/alacritty/)"
    trans["unpack_hackeros_tv"] = "Install HackerOS TV"
    trans["unpack_winboat"] = "Install Winboat"
    trans["unpack_nvidia"] = "Install NVIDIA drivers"
    trans["unpack_hl_utils"] = "Install Hacker Lang utilities (hl-utils)"
    trans["unpack_flox"] = "Install Flox"
    trans["unpack_builder"] = "Install HackerOS Builder"
    trans["unpack_isolator"] = "Install Isolator"
    trans["unpack_hydra"] = "Install Hydra look-and-feel"
    trans["unpack_hammer"] = "Install Hammer"
    trans["unpack_hackeros-games"] = "Install HackerOS game add-ons"
    trans["unpack_lpm"] = "Install LPM"
    trans["unpack_hackerscript"] = "Install HackerScript"
    trans["unpack_hexai"] = "Install HexAi"
    trans["unpack_hackerscript_utils"] = "Install HackerScript utilities"
    trans["unpack_hackerdeck"] = "Install HackerDeck"
    trans["unpack_hackeros_containers"] = "Install HackerOS containers (e.g., blackarch, kali)"
    trans["unpack_hsharp"] = "Install H# (H-Sharp) tools – programming language for HackerOS"

    // Translations from pack
    trans["pack_downloading"] = "Downloading removal script"
    trans["pack_full_done"] = "Full removal completed."
    trans["pack_alacritty_done"] = "Alacritty configuration removed."
    trans["pack_done"] = "Removal completed."
    trans["pack_unknown"] = "Unknown pack subcommand:"
    trans["pack_title"] = "Pack subcommands:"
    trans["pack_add_ons"] = "Remove wine and related tools"
    trans["pack_gs"] = "Remove gaming and cybersecurity"
    trans["pack_devtools"] = "Remove developer tools"
    trans["pack_emulators"] = "Remove emulators"
    trans["pack_cybersecurity"] = "Remove BlackArch container"
    trans["pack_select"] = "Run hacker-select in pack mode"
    trans["pack_gaming"] = "Remove gaming tools"
    trans["pack_hacker_mode"] = "Remove hacker mode tools"
    trans["pack_gamescope"] = "Remove gamescope session for Steam"
    trans["pack_auto_updates"] = "Disable automatic updates"
    trans["pack_alacritty"] = "Remove Alacritty configuration"
    trans["pack_hackeros_tv"] = "Remove HackerOS TV"
    trans["pack_winboat"] = "Remove Winboat"
    trans["pack_nvidia"] = "Remove NVIDIA drivers"
    trans["pack_hl_utils"] = "Remove Hacker Lang utilities (hl-utils)"
    trans["pack_flox"] = "Remove Flox"
    trans["pack_builder"] = "Remove HackerOS Builder"
    trans["pack_isolator"] = "Remove Isolator"
    trans["pack_hammer"] = "Remove Hammer"
    trans["pack_lpm"] = "Remove LPM"
    trans["pack_hackeros-games"] = "Remove HackerOS game add-ons"
    trans["pack_hackerscript"] = "Remove HackerScript"
    trans["pack_hexai"] = "Remove HexAi"
    trans["pack_hackerscript_utils"] = "Remove HackerScript utilities"
    trans["pack_hackerdeck"] = "Remove HackerDeck"
    trans["pack_hackeros_containers"] = "Remove HackerOS containers"
    trans["pack_hsharp"] = "Remove H# (H-Sharp) tools"

    // Translations for switch
    trans["switch_subcommands"] = "Switch subcommands:"
    trans["hacker_mode_desc"] = "Switch to Hacker-Mode (Wayland session)"
    trans["steam_gamemode_desc"] = "Switch to Steam gaming mode (gamescope-session)"
    trans["unknown_switch"] = "Unknown switch subcommand:"

    return trans
}
