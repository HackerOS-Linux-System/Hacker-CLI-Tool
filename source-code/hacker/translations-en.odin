package hackeros

en_translations :: proc() -> map[string]string {
    trans: map[string]string
    // Translations from env
    trans["env_create_usage"] = "Usage: hacker env create <file.hk|file.yaml>"
    trans["env_remove_usage"] = "Usage: hacker env remove <name>"
    trans["env_unknown_sub"] = "Unknown env subcommand:"
    trans["file_not_exists"] = "File does not exist:"
    trans["env_missing_fields"] = "Missing required fields name or image in configuration file"
    trans["env_creating"] = "Creating environment"
    trans["env_created"] = "Environment has been created successfully!"
    trans["env_removed"] = "Environment has been removed."
    trans["env_list"] = "List of all Hacker env environments:"
    trans["env_subcommands"] = "Env subcommands:"
    trans["env_create_desc"] = "Create new environment from file"
    trans["env_remove_desc"] = "Remove environment"
    trans["env_enter_desc"] = "Enter environment (with mounted tools)"
    trans["env_docs_desc"] = "Full tutorial + examples"
    trans["env_settings_desc"] = "List all environments"
    trans["env_docs"] = `
    %s=== Hacker env – full tutorial ===%s
    1. Create a configuration file (e.g., pentest.hk):
    [env]
    -> name => pentest-env
    -> image => fedora:latest
    -> shell => zsh
    [packages]
    -> -> nmap
    -> -> metasploit-framework
    -> -> burpsuite
    [sync_configs]
    -> -> ~/.zshrc
    -> -> ~/.config/nvim
    [sync_tools]
    -> snap => ["code"]
    -> flatpak => ["com.brave.Browser"]
    -> system => ["~/go/bin/gf"]
    2. Create environment:
    hacker env create ./pentest.hk
    3. Enter:
    hacker env enter pentest-env
    4. Remove:
    hacker env remove pentest-env
    All environments are normal podman containers – you can use distrobox enter / podman exec normally.
    `

    // Translations from main
    trans["usage_install"] = "Usage: hacker install <package>"
    trans["usage_remove"] = "Usage: hacker remove <package>"
    trans["usage_flatpak_install"] = "Usage: hacker flatpak-install <package>"
    trans["usage_flatpak_remove"] = "Usage: hacker flatpak-remove <package>"
    trans["usage_enter"] = "Usage: hacker enter <name>"
    trans["usage_remove_container"] = "Usage: hacker remove-container <name>"
    trans["usage_restart"] = "Usage: hacker restart <service>"
    trans["how_to_create1"] = "How to create custom commands:"
    trans["how_to_create2"] = "1. Create .hacker file in ~/.hackeros/custom"
    trans["how_to_create3"] = "2. Add [config] -> exec => command to execute"
    trans["version_tool"] = "Tool version: 2.3"
    trans["version_os"] = "version: HackerOS v4.4"
    trans["file_not_found"] = "File not found:"
