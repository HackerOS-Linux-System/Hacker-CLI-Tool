	trans["tool_store"] = "Sklep HackerOS"
	trans["tool_hsh"] = "własna powłoka (można używać zamiast zsh/bash)"
	trans["tool_getit"] = "narzędzie cli do pobierania katalogów z githuba/gitlaba. Można stosować również jako zamiennik dla wget/curl i git"
	trans["tool_builder"] = "nakładka dla live build"
