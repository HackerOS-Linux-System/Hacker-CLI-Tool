	trans["tool_hpm"] = "Manager community pakietów"
	trans["tool_game_mode"] = "tryb gry inspirowany asus armoury crate"
	trans["tool_hup"] = "system automatycznych aktualizacji"
	trans["tool_hammer"] = "system do atomowego systemu instalacji pakietow/aktualizacji (używane tylko w edycji atomic)"
	trans["tool_games"] = "gui do uruchamiania gier: starblaster, bit-jump, bark squadron, the racer"
	trans["tool_cockpit"] = "centrum sterowania systemem w przeglądarce"
