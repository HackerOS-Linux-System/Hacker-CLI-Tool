;; ── Kolory ANSI ───────────────────────────────────────────────────────────────

pub struct Colors is
    pub red:     string
    pub yellow:  string
    pub green:   string
    pub magenta: string
    pub gray:    string
    pub bold:    string
    pub reset:   string
    pub blue:    string
    pub cyan:    string
    pub white:   string
end

pub fn default_colors() -> Colors is
    return Colors {
        red:     "\x1b[31m",
        yellow:  "\x1b[33m",
        green:   "\x1b[32m",
        magenta: "\x1b[35m",
        gray:    "\x1b[90m",
        bold:    "\x1b[1m",
        reset:   "\x1b[0m",
        blue:    "\x1b[34m",
        cyan:    "\x1b[36m",
        white:   "\x1b[37m",
    }
end

pub fn make_ansi_rgb(r: int, g: int, b: int) -> string is
    return "\x1b[38;2;" + to_string(r) + ";" + to_string(g) + ";" + to_string(b) + "m"
end

pub fn parse_hex2(s: string) -> int is
    let mut val: int = 0
    let mut i:   int = 0
    while i < string_len(s) is
        val = val * 16
        let ch: string = string_at(s, i)
        if ch >= "0" && ch <= "9" is
            val += to_int(ch)
        else if ch >= "a" && ch <= "f" is
            val += to_int_from_hex(ch)
        else if ch >= "A" && ch <= "F" is
            val += to_int_from_hex(string_lower(ch))
        end
        i += 1
    end
    return val
end

pub fn hex_to_ansi(hex: string) -> string is
    if string_len(hex) != 7 || string_at(hex, 0) != "#" is return "" end
    let r: int = parse_hex2(string_slice(hex, 1, 3))
    let g: int = parse_hex2(string_slice(hex, 3, 5))
    let b: int = parse_hex2(string_slice(hex, 5, 7))
    return make_ansi_rgb(r, g, b)
end

;; ── Wypisywanie ───────────────────────────────────────────────────────────────

pub fn print_error(c: Colors, msg: string) is
    write(c.red + "[ERROR] " + msg + c.reset)
end

pub fn print_warning(c: Colors, msg: string) is
    write(c.yellow + "[WARN] " + msg + c.reset)
end

pub fn print_info(c: Colors, msg: string) is
    write(c.green + "[INFO] " + msg + c.reset)
end

;; ── safe_run ─────────────────────────────────────────────────────────────────

pub fn safe_run(cmd: string, c: Colors) -> bool is
    let rc: int = system(cmd)
    if rc != 0 is
        write(c.red + "[ERROR] Command failed (exit " + to_string(rc) + "): " + cmd + c.reset)
        return false
    end
    return true
end

pub fn safe_run_silent(cmd: string) -> bool is
    let rc: int = system(cmd + " >/dev/null 2>&1")
    return rc == 0
end

