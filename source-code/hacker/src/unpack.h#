mod helpers
mod translations

pub fn handle_unpack(args: [string], argc: int, lang: string, c: helpers::Colors) is
    let t: translations::Trans = translations::get_translations(lang)
    if argc == 0 || args[0] == "help" is
        show_unpack_help(t, c)
        return
    end
    let sub: string = args[0]

    match sub is
        "add-ons" => is
            helpers::safe_run("sudo apt install -y wine winetricks", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub io.github.dvlv.boxbuddyrs", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub it.mijorus.winezgui", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub it.mijorus.gearlever", c)
        end
        "gs" => is
            let sub_args: [string] = ["gaming"]
            handle_unpack(sub_args, 1, lang, c)
            let sub_args2: [string] = ["cybersecurity"]
            handle_unpack(sub_args2, 1, lang, c)
        end
        "devtools" => is
            helpers::safe_run("flatpak install -y --noninteractive flathub com.visualstudio.code", c)
            helpers::safe_run("sudo apt install -y crystal shards", c)
            helpers::safe_run("sudo apt install -y npm nodejs", c)
            helpers::safe_run("curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y", c)
            helpers::safe_run("sudo apt install -y golang", c)
            helpers::safe_run("sudo apt install -y lua5.4", c)
            helpers::safe_run("sudo snap install zig --beta --classic", c)
        end
        "emulators" => is
            helpers::safe_run("flatpak install -y --noninteractive flathub org.shadps4.shadPS4", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub io.ryujinx.Ryujinx", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub com.dosbox_x.DOSBox-X", c)
            helpers::safe_run("sudo snap install rpcs3-emu", c)
        end
        "cybersecurity" => is
            helpers::safe_run("distrobox create --name blackarch --image docker.io/blackarchlinux/blackarch:latest --additional-flags \"--privileged\" || true", c)
            write(c.yellow + translations::trans_get(t, "unpack_blackarch_info1") + c.reset)
            write(translations::trans_get(t, "unpack_blackarch_info2"))
        end
        "select" => is
            helpers::safe_run("~/.hackeros/hacker/hacker-select", c)
        end
        "gaming" => is
            helpers::safe_run("flatpak install -y --noninteractive flathub com.valvesoftware.Steam", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub com.github.Matoking.protontricks", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub net.lutris.Lutris", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub com.heroicgameslauncher.hgl", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub io.github.antimicrox.antimicrox", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub net.davidotek.pupgui2", c)
        end
        "gaming-roblox" => is
            let sub_args: [string] = ["gaming"]
            handle_unpack(sub_args, 1, lang, c)
            helpers::safe_run("flatpak install -y --noninteractive flathub org.vinegarhq.Sober", c)
            write(c.green + translations::trans_get(t, "unpack_roblox_done") + c.reset)
        end
        "hacker-mode" => is
            helpers::safe_run("git clone https://github.com/HackerOS-Linux-System/Hacker-Mode.git /tmp/Hacker-Mode || true", c)
            helpers::safe_run("hl run /tmp/Hacker-Mode/unpack.hl", c)
        end
        "gamescope-session-steam" => is
            helpers::safe_run("flatpak install -y --noninteractive flathub com.valvesoftware.Steam", c)
            helpers::safe_run("flatpak install -y --noninteractive flathub org.freedesktop.Platform.VulkanLayer.gamescope", c)
            helpers::safe_run("sudo apt install -y gamescope", c)
            helpers::safe_run("git clone https://github.com/HackerOS-Linux-System/gamescope-session-steam.git /tmp/gamescope-session-steam || true", c)
            helpers::safe_run("hl run /tmp/gamescope-session-steam/install.hl", c)
        end
        "automatic-updates" => is
            helpers::safe_run("sudo cp /usr/share/HackerOS/Archived/Services/hup.service /etc/systemd/system/hup.service", c)
            helpers::safe_run("sudo systemctl daemon-reload", c)
            helpers::safe_run("sudo systemctl enable --now hup.service", c)
        end
        "alacritty-config" => is
            helpers::safe_run("mkdir -p ~/.config/alacritty", c)
            helpers::safe_run("cp /usr/share/HackerOS/Archived/alacritty.toml ~/.config/alacritty/alacritty.toml", c)
            write(c.green + translations::trans_get(t, "unpack_alacritty_done") + c.reset)
        end
        "hackeros-tv" => is
            helpers::safe_run("git clone https://github.com/HackerOS-Linux-System/HackerOS-TV.git /tmp/HackerOS-TV || true", c)
            helpers::safe_run("hl run /tmp/HackerOS-TV/unpack.hl", c)
        end
        "winboat" => is
            helpers::safe_run("wget https://github.com/TibixDev/winboat/releases/download/v0.9.0/winboat-0.9.0-amd64.deb -O /tmp/winboat.deb", c)
            helpers::safe_run("sudo apt install -y /tmp/winboat.deb", c)
        end
        "nvidia-drivers" => is
            helpers::safe_run("/usr/share/HackerOS/Scripts/Bin/unpack-nvidia-drivers.sh", c)
        end
        "hackeros-containers" => is
            write(c.yellow + translations::trans_get(t, "unpack_downloading") + " hackeros-containers..." + c.reset)
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Containers/main/install.hl -o /tmp/install-containers.hl", c)
            helpers::safe_run("hl run /tmp/install-containers.hl", c)
            write(c.green + translations::trans_get(t, "unpack_done") + c.reset)
        end
        "h#" | "hl-utils" => is
            write(c.yellow + translations::trans_get(t, "unpack_downloading") + " H# (H-Sharp)..." + c.reset)
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/H-Sharp/main/install-remove/HackerOS/install.hl -o /tmp/hsharp-install.hl", c)
            helpers::safe_run("hl run /tmp/hsharp-install.hl", c)
        end
        "h#-utils" => is
            write(c.yellow + translations::trans_get(t, "unpack_downloading") + " H# Utils..." + c.reset)
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/H-Sharp/main/install-remove/HackerOS/install-utils.hl -o /tmp/hsharp-utils-install.hl", c)
            helpers::safe_run("hl run /tmp/hsharp-utils-install.hl", c)
        end
        "flox" => is
            helpers::safe_run("wget https://downloads.flox.dev/by-env/stable/deb/flox.x86_64-linux.deb -O /tmp/flox.deb", c)
            helpers::safe_run("sudo apt install -y /tmp/flox.deb", c)
        end
        "hackeros-builder" => is
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Builder/main/install.hl -o /tmp/install-builder.hl", c)
            helpers::safe_run("hl run /tmp/install-builder.hl", c)
        end
        "isolator" => is
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/Isolator/main/install.hl -o /tmp/install-isolator.hl", c)
            helpers::safe_run("hl run /tmp/install-isolator.hl", c)
        end
        "hydra" => is
            write(c.yellow + translations::trans_get(t, "unpack_downloading") + " hydra-look-and-feel..." + c.reset)
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Hydra/main/install.hl -o /tmp/install-hydra.hl", c)
            helpers::safe_run("hl run /tmp/install-hydra.hl", c)
            write(c.yellow + translations::trans_get(t, "unpack_hydra_warning") + c.reset)
        end
        "hammer" => is
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/Hammer/main/install.hl -o /tmp/install-hammer.hl", c)
            helpers::safe_run("hl run /tmp/install-hammer.hl", c)
        end
        "hackeros-games" => is
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Games/main/install.hl -o /tmp/install-games.hl", c)
            helpers::safe_run("hl run /tmp/install-games.hl", c)
        end
        "lpm" => is
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/LPM/main/install.hl -o /tmp/install-lpm.hl", c)
            helpers::safe_run("hl run /tmp/install-lpm.hl", c)
        end
        "hexai" => is
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/HexAi/main/install.hl -o /tmp/install-hexai.hl", c)
            helpers::safe_run("hl run /tmp/install-hexai.hl", c)
        end
        "hackerdeck" => is
            helpers::safe_run("curl -fsSL https://raw.githubusercontent.com/HackerOS-Linux-System/HackerDeck/main/install.hl -o /tmp/install-hackerdeck.hl", c)
            helpers::safe_run("hl run /tmp/install-hackerdeck.hl", c)
        end
        _ => is
            helpers::print_error(c, translations::trans_get(t, "unpack_unknown") + " " + sub)
            show_unpack_help(t, c)
        end
    end
end

fn show_unpack_help(t: translations::Trans, c: helpers::Colors) is
    write(c.bold + c.magenta + translations::trans_get(t, "unpack_title") + c.reset)
    let cmds: [[string]] = [
        ["add-ons",               translations::trans_get(t, "unpack_add_ons")],
        ["gs",                    translations::trans_get(t, "unpack_gs")],
        ["devtools",              translations::trans_get(t, "unpack_devtools")],
        ["emulators",             translations::trans_get(t, "unpack_emulators")],
        ["cybersecurity",         translations::trans_get(t, "unpack_cybersecurity")],
        ["select",                translations::trans_get(t, "unpack_select")],
        ["gaming",                translations::trans_get(t, "unpack_gaming")],
        ["gaming-roblox",         translations::trans_get(t, "unpack_gaming_roblox")],
        ["hacker-mode",           translations::trans_get(t, "unpack_hacker_mode")],
        ["gamescope-session-steam", translations::trans_get(t, "unpack_gamescope")],
        ["automatic-updates",     translations::trans_get(t, "unpack_auto_updates")],
        ["alacritty-config",      translations::trans_get(t, "unpack_alacritty")],
        ["hackeros-tv",           translations::trans_get(t, "unpack_hackeros_tv")],
        ["winboat",               translations::trans_get(t, "unpack_winboat")],
        ["nvidia-drivers",        translations::trans_get(t, "unpack_nvidia")],
        ["hackeros-containers",   translations::trans_get(t, "unpack_hackeros_containers")],
        ["h#",                    translations::trans_get(t, "unpack_hsharp")],
        ["h#-utils",              translations::trans_get(t, "unpack_hsharp_utils")],
        ["flox",                  translations::trans_get(t, "unpack_flox")],
        ["hackeros-builder",      translations::trans_get(t, "unpack_builder")],
        ["isolator",              translations::trans_get(t, "unpack_isolator")],
        ["hydra",                 translations::trans_get(t, "unpack_hydra")],
        ["hammer",                translations::trans_get(t, "unpack_hammer")],
        ["hackeros-games",        translations::trans_get(t, "unpack_hackeros_games")],
        ["lpm",                   translations::trans_get(t, "unpack_lpm")],
        ["hexai",                 translations::trans_get(t, "unpack_hexai")],
        ["hackerdeck",            translations::trans_get(t, "unpack_hackerdeck")],
    ]
    let n: int = array_len(cmds)
    let mut i: int = 0
    while i < n is
        write(" " + c.gray + string_pad_right(cmds[i][0], 30) + c.reset + "- " + cmds[i][1])
        i += 1
    end
end
