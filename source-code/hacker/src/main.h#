    let valid: [string] = ["pl","en","de","fr","es","it","ru","zh","ja","ko","pt","ar","hi"]
    let n: int = array_len(valid)
    let mut found: bool = false
    let mut i: int = 0
    while i < n is
        if valid[i] == lang is found = true end
        i += 1
    end
    if !found is
        write("Nieznany język: " + lang + ". Dostępne: pl en de fr es it ru zh ja ko")
        exit(1)
    end
    helpers::save_language(lang)
    write("Język ustawiony na: " + lang)
end

