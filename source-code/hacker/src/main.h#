;; ── Arg helpers ──────────────────────────────────────────────────────────────

fn arg_at(args: [string], argc: int, idx: int) -> string is
    if idx < argc is return args[idx] end
    return ""
end

fn args_from(args: [string], argc: int, start_idx: int) -> [string] is
    let mut result: [string] = []
    let mut i: int = start_idx
    while i < argc is
        result = array_push(result, args[i])
        i += 1
    end
    return result
end

fn args_join(args: [string], argc: int) -> string is
    let mut s: string = ""
    let mut i: int = 0
    while i < argc is
        if i > 0 is s = s + " " end
        s = s + args[i]
        i += 1
    end
    return s
end

fn detect_de() -> string is
    let xdg: string = getenv("XDG_CURRENT_DESKTOP")
    let ds:  string = getenv("DESKTOP_SESSION")
    let env_str: string = string_lower(xdg + " " + ds)
    if string_contains(env_str, "plasma") || string_contains(env_str, "kde") is
        return "plasma-desktop"
    end
    if string_contains(env_str, "gnome") is return "gnome"    end
    if string_contains(env_str, "xfce")  is return "xfce4"   end
    return ""
end

fn kill_de(de: string, c: helpers::Colors) is
    match de is
        "plasma-desktop" => is helpers::safe_run("killall -9 plasmashell kwin_wayland kwin_x11 krunner kded5", c) end
        "gnome"          => is helpers::safe_run("killall -9 gnome-shell", c) end
        "xfce4"          => is helpers::safe_run("killall -9 xfce4-session xfwm4 xfdesktop", c) end
        _                => is end
    end
end

;; ── doctor ───────────────────────────────────────────────────────────────────

fn handle_doctor(lang: string, c: helpers::Colors) is
    let t: translations::Trans = translations::load(lang)

    write(c.bold + c.magenta + "╔══════════════════════════════════════╗" + c.reset)
    write("║   " + c.cyan + "HackerOS Doctor" + c.magenta + " — Diagnoza systemu    ║" + c.reset)
    write(c.magenta + "╚══════════════════════════════════════╝" + c.reset)
    write("")
    write(c.yellow + translations::get(t, "doctor_intro") + c.reset)
    write("")

    write(c.cyan + "[1/4]" + c.reset + " " + translations::get(t, "doctor_check_dpkg"))
    let ok1: bool = helpers::safe_run("dpkg --audit 2>&1 | head -5", c)
    if ok1 is write("      " + c.green + "✓ dpkg OK" + c.reset)
    else is    write("      " + c.yellow + "⚠ Wykryto problemy dpkg" + c.reset) end

    write(c.cyan + "[2/4]" + c.reset + " " + translations::get(t, "doctor_check_disk"))
    helpers::safe_run("df -h / | tail -1", c)

    write(c.cyan + "[3/4]" + c.reset + " " + translations::get(t, "doctor_check_net"))
    let ok3: bool = helpers::safe_run("ping -c 1 -W 2 8.8.8.8 > /dev/null 2>&1", c)
    if ok3 is write("      " + c.green + "✓ Sieć OK" + c.reset)
    else is    write("      " + c.yellow + "⚠ Brak połączenia z internetem" + c.reset) end

    write(c.cyan + "[4/4]" + c.reset + " " + translations::get(t, "doctor_check_services"))
    helpers::safe_run("systemctl list-units --state=failed --no-pager 2>/dev/null | head -5 || echo 'Brak awarii usług'", c)

    write("")
    write(c.bold + translations::get(t, "doctor_prompt") + c.reset)
    write(c.green + "  y / t" + c.reset + " — " + translations::get(t, "doctor_yes"))
    write(c.red   + "  n / q" + c.reset + " — " + translations::get(t, "doctor_no"))
    write(c.magenta + "❯ " + c.reset)

    let answer: string = string_lower(string_trim(io_readline()))

    if answer == "y" || answer == "t" || answer == "yes" || answer == "tak" is
        let repair_bin: string = helpers::get_home_path(".hackeros/hacker/hacker-repair")
        if helpers::path_exists(repair_bin) is
            write(c.green + translations::get(t, "doctor_launching_repair") + c.reset)
            helpers::safe_run(repair_bin, c)
        else is
            helpers::print_error(c, translations::get(t, "repair_not_found"))
            write(c.yellow + translations::get(t, "repair_install_hint") + c.reset)
        end
    else is
        write(c.gray + translations::get(t, "doctor_cancelled") + c.reset)
    end
end

;; ── switch ────────────────────────────────────────────────────────────────────

fn switch_session(session_file: string, mode_name: string, c: helpers::Colors) is
    if !helpers::path_exists(session_file) is
        helpers::print_error(c, "Plik " + session_file + " nie został znaleziony!")
        helpers::print_warning(c, "Zainstaluj przez: hacker unpack " + mode_name)
        exit(1)
    end
    let de: string = detect_de()
    if de == "" is
        helpers::print_error(c, "Nie wykryto obsługiwanego środowiska.")
        exit(1)
    end
    write(c.yellow + "Wykryto środowisko: " + de + ". Wyłączam..." + c.reset)
    kill_de(de, c)

    let dm: string = helpers::detect_display_manager()
    if string_contains(dm, "lightdm") || string_contains(dm, "sddm") ||
       string_contains(dm, "gdm") || string_contains(dm, "gdm3") is
        write(c.green + "Wykryto DM: " + dm + ". Uruchamiam sesję " + mode_name + "..." + c.reset)
        let exec_cmd: string = helpers::get_desktop_exec(session_file)
        if exec_cmd != "" is
            helpers::safe_run(exec_cmd, c)
        else is
            helpers::print_error(c, "Nie znaleziono linii Exec= w pliku .desktop.")
        end
    else is
        helpers::print_warning(c, "DM (" + dm + ") nie jest lightdm/sddm/gdm. Zaloguj się ręcznie.")
    end
end

fn handle_switch(args: [string], argc: int, lang: string, c: helpers::Colors) is
    let t: translations::Trans = translations::load(lang)
    if argc == 0 is
        write(c.bold + c.magenta + translations::get(t, "switch_subcommands") + c.reset)
        write(" " + c.gray + "hacker-mode      " + c.reset + "- " + translations::get(t, "hacker_mode_desc"))
        write(" " + c.gray + "steam-gamemode   " + c.reset + "- " + translations::get(t, "steam_gamemode_desc"))
        return
    end
    match args[0] is
        "hacker-mode"      => is switch_session("/usr/share/wayland-sessions/Hacker-Mode.desktop", "hacker-mode", c) end
        "steam-gamemode"   => is switch_session("/usr/share/wayland-sessions/gamescope-session-steam.desktop", "steam-gamemode", c) end
        _ => is
            helpers::print_error(c, "Unknown switch: " + args[0])
            exit(1)
        end
    end
end

