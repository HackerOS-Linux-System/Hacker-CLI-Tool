fn handle_update(args: [string], argc: int, lang: string, c: helpers::Colors) is
    let t: translations::Trans = translations::load(lang)
    helpers::run_plugin_update_hooks("pre_update", c)
    if argc == 0 is
        helpers::safe_run("~/.hackeros/hacker/HackerOS-Updater", c)
    else is
        match args[0] is
            "--with-gui" => is helpers::safe_run("~/.hackeros/hacker/HackerOS-Updater --with-gui", c) end
            _ => is
                helpers::print_error(c, translations::get(t, "available_flags") + " --with-gui")
                exit(1)
            end
        end
    end
    helpers::run_plugin_update_hooks("post_update", c)
end

