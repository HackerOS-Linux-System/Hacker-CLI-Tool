mod helpers
mod translations

extern dynamic [c] is
    fn system(cmd: string) -> int
end

pub struct EnvConfig is
    pub name:    string
    pub image:   string
    pub shell:   string
    pub packages:     [string]
    pub pkg_count:    int
    pub sync_configs: [string]
    pub cfg_count:    int
end

fn parse_env_file(path: string) -> EnvConfig is
    let mut cfg: EnvConfig = EnvConfig {
        name: "", image: "", shell: "bash",
        packages: [], pkg_count: 0,
        sync_configs: [], cfg_count: 0,
    }
    if !helpers::path_exists(path) is return cfg end

    let content: string = file_read(path)
    let lines:   [string] = string_split(content, "\n")
    let nlines:  int      = array_len(lines)
    let mut section: string = ""
    let mut i: int = 0

    while i < nlines is
        let raw:  string = lines[i]
        let line: string = string_trim(raw)
        i += 1
        if line == "" || string_starts_with(line, "!") is continue end

        if string_starts_with(line, "[") && string_ends_with(line, "]") is
            section = string_slice(line, 1, string_len(line) - 1)
            continue
        end

        if string_starts_with(line, "->") is
            let after: string = string_trim(string_slice(line, 2, string_len(line)))
            let eq:    int    = string_find(after, "=>")
            if eq < 0 is continue end
            let key: string = string_trim(string_slice(after, 0, eq))
            let val: string = string_trim(string_slice(after, eq + 2, string_len(after)))

            match section is
                "env" => is
                    match key is
                        "name"  => is cfg.name  = val end
                        "image" => is cfg.image = val end
                        "shell" => is cfg.shell = val end
                        _       => is end
                    end
                end
                "packages" => is
                    cfg.packages  = array_push(cfg.packages, val)
                    cfg.pkg_count += 1
                end
                "sync_configs" => is
                    cfg.sync_configs = array_push(cfg.sync_configs, val)
                    cfg.cfg_count    += 1
                end
                _ => is end
            end
        end
    end
    return cfg
end

pub fn handle_env(args: [string], argc: int, lang: string, c: helpers::Colors) is
    let t: translations::Trans = translations::get_translations(lang)
    if argc == 0 || args[0] == "help" is
        show_env_help(t, c)
        return
    end
    let sub: string = args[0]

    match sub is
        "create" => is
            if argc < 2 is
                helpers::print_error(c, translations::trans_get(t, "env_create_usage"))
                return
            end
            env_create(args[1], t, c)
        end
        "remove" => is
            if argc < 2 is
                helpers::print_error(c, translations::trans_get(t, "env_remove_usage"))
                return
            end
            env_remove(args[1], t, c)
        end
        "enter" => is
            let name: string = if argc >= 2 then args[1] else "" end
            env_enter(name, c)
        end
        "docs" => is
            env_docs(c)
        end
        "settings" => is
            env_settings(t, c)
        end
        _ => is
            helpers::print_error(c, translations::trans_get(t, "env_unknown_sub") + " " + sub)
            show_env_help(t, c)
        end
    end
end

fn env_create(file_path: string, t: translations::Trans, c: helpers::Colors) is
    if !helpers::path_exists(file_path) is
        helpers::print_error(c, translations::trans_get(t, "file_not_exists") + " " + file_path)
        return
    end
    let cfg: EnvConfig = parse_env_file(file_path)
    if cfg.name == "" || cfg.image == "" is
        helpers::print_error(c, translations::trans_get(t, "env_missing_fields"))
        return
    end

    write(c.yellow + translations::trans_get(t, "env_creating") + " " + cfg.name + " (" + cfg.image + ")..." + c.reset)

    let create_cmd: string = "podman create --name " + cfg.name +
        " --label hacker-env=true --hostname " + cfg.name + " -it " + cfg.image
    helpers::safe_run(create_cmd, c)

    if cfg.shell == "zsh" is
        helpers::safe_run("podman exec " + cfg.name + " bash -c 'apt update && apt install -y zsh || dnf install -y zsh || true'", c)
        helpers::safe_run("podman exec " + cfg.name + " chsh -s /bin/zsh root", c)
    end

    let mut pi: int = 0
    while pi < cfg.pkg_count is
        let pkg: string = cfg.packages[pi]
        helpers::safe_run("podman exec " + cfg.name +
            " bash -c 'if command -v apt > /dev/null; then apt install -y " + pkg +
            "; elif command -v dnf > /dev/null; then dnf install -y " + pkg + "; fi'", c)
        pi += 1
    end

    let home: string = helpers::get_home()
    let mut ci: int = 0
    while ci < cfg.cfg_count is
        let cfg_path: string = cfg.sync_configs[ci]
        let host: string   = string_replace(cfg_path, "~", home)
        let target: string = string_replace(cfg_path, "~", "/root")
        if helpers::path_exists(host) is
            helpers::safe_run("podman cp " + host + " " + cfg.name + ":" + target, c)
        end
        ci += 1
    end

    write(c.green + translations::trans_get(t, "env_created") + " " + cfg.name + "!" + c.reset)
end

fn env_remove(name: string, t: translations::Trans, c: helpers::Colors) is
    helpers::safe_run("podman rm -f " + name + " 2>/dev/null || true", c)
    write(c.green + translations::trans_get(t, "env_removed") + " " + name + c.reset)
end

fn env_enter(name: string, c: helpers::Colors) is
    if name == "" is
        helpers::safe_run("podman ps -a --filter \"label=hacker-env=true\" --format \"{{.Names}}\"", c)
        return
    end
    helpers::safe_run("podman start " + name + " 2>/dev/null || true && podman exec -it " + name + " zsh || bash", c)
end

fn env_docs(c: helpers::Colors) is
    write("")
    write(c.bold + "=== Hacker env — pełny tutorial ===" + c.reset)
    write("1. Utwórz plik konfiguracyjny (np. pentest.hk):")
    write("   [env]")
    write("   -> name  => pentest-env")
    write("   -> image => fedora:latest")
    write("   -> shell => zsh")
    write("   [packages]")
    write("   -> -> nmap")
    write("   -> -> metasploit-framework")
    write("   [sync_configs]")
    write("   -> -> ~/.zshrc")
    write("")
    write("2. Utwórz środowisko:  hacker env create ./pentest.hk")
    write("3. Wejdź:             hacker env enter pentest-env")
    write("4. Usuń:              hacker env remove pentest-env")
    write("")
end

fn env_settings(t: translations::Trans, c: helpers::Colors) is
    write(c.magenta + translations::trans_get(t, "env_list") + c.reset)
    helpers::safe_run("podman ps -a --filter \"label=hacker-env=true\" --format \"table {{.Names}}\\t{{.Image}}\\t{{.Status}}\"", c)
end

fn show_env_help(t: translations::Trans, c: helpers::Colors) is
    write(c.bold + c.magenta + translations::trans_get(t, "env_subcommands") + c.reset)
    write(" " + c.gray + string_pad_right("create <plik.hk>", 28) + c.reset + "- " + translations::trans_get(t, "env_create_desc"))
    write(" " + c.gray + string_pad_right("remove <nazwa>",   28) + c.reset + "- " + translations::trans_get(t, "env_remove_desc"))
    write(" " + c.gray + string_pad_right("enter [nazwa]",    28) + c.reset + "- " + translations::trans_get(t, "env_enter_desc"))
    write(" " + c.gray + string_pad_right("docs",             28) + c.reset + "- " + translations::trans_get(t, "env_docs_desc"))
    write(" " + c.gray + string_pad_right("settings",         28) + c.reset + "- " + translations::trans_get(t, "env_settings_desc"))
end
