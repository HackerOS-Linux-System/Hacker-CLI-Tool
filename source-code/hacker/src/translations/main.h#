pub fn get_translations(lang: string) -> Trans is
    match lang is
        "pl" => return pl_translations()
        "en" => return en_translations()
        "de" => return de_translations()
        "fr" => return fr_translations()
        "es" => return es_translations()
        "it" => return it_translations()
        "ru" => return ru_translations()
        "zh" => return zh_translations()
        "ja" => return ja_translations()
        "ko" => return ko_translations()
        _    => return pl_translations()
    end
end
