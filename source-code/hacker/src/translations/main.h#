mod pl
mod en
mod de
mod fr
mod es
mod it
mod ru
mod zh
mod ja
mod ko

pub struct Trans is
    pub entries: [string]
    pub count:   int
end

pub fn make(raw: [string]) -> Trans is
    return Trans { entries: raw, count: array_len(raw) }
end

pub fn get(t: Trans, key: string) -> string is
    ;; Each entry is "key\x01value". \x01 (not \x00!) is the delimiter on
    ;; purpose: H# strings are plain null-terminated C strings under the
    ;; hood (see hsh_strlen/hsh_string_slice in core.c), so a genuine \x00
    ;; embedded inside one is invisible to every string builtin — string_len,
    ;; string_slice, and string concatenation (`+`, used to build `search`
    ;; below) all silently stop at the first \0 they see. The original
    ;; \x00-delimited scheme could never actually work: `key + "\x00"`
    ;; always came back as just `key` (concatenating a strlen-0 "\x00"
    ;; appends nothing), and slicing past a real embedded \0 in `t.entries[i]`
    ;; always returned an empty string — every lookup silently fell through
    ;; to `return key` at the bottom, showing the raw translation key
    ;; instead of the translated text (this is why every menu/help string
    ;; in this program used to show as e.g. "help_unpack" instead of real
    ;; text). \x01 (SOH) survives all of that unscathed since it's just an
    ;; ordinary non-zero byte to strlen/strncmp, while still being safely
    ;; outside the printable-text range so it can never collide with a
    ;; real translation value. binary search would be ideal but linear
    ;; scan is fine for ~277 keys.
    let search: string = key + "\x01"
    let mut i: int = 0
    while i < t.count is
        if string_starts_with(t.entries[i], search) is
            return string_slice(t.entries[i], string_len(search), string_len(t.entries[i]))
        end
        i += 1
    end
    return key
end

pub fn load(lang: string) -> Trans is
    let raw: [string] = match lang is
        "pl" => pl::pl_translations()
        "en" => en::en_translations()
        "de" => de::de_translations()
        "fr" => fr::fr_translations()
        "es" => es::es_translations()
        "it" => it::it_translations()
        "ru" => ru::ru_translations()
        "zh" => zh::zh_translations()
        "ja" => ja::ja_translations()
        "ko" => ko::ko_translations()
        _    => pl::pl_translations()
    end
    return make(raw)
end
