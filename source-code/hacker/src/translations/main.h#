pub struct Trans is
    pub data:  [string]
    pub keys:  [string]
    pub count: int
end

pub fn trans_get(t: Trans, key: string) -> string is
    let mut i: int = 0
    while i < t.count is
        if t.keys[i] == key is return t.data[i] end
        i += 1
    end
    return key
end

fn make_trans(keys: [string], vals: [string], n: int) -> Trans is
    return Trans { data: vals, keys: keys, count: n }
end

