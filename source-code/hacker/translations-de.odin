package hackeros

de_translations :: proc() -> map[string]string {
    trans: map[string]string
    // Tłumaczenia z env
    trans["env_create_usage"] = "Verwendung: hacker env create <datei.hk|datei.yaml>"
    trans["env_remove_usage"] = "Verwendung: hacker env remove <name>"
    trans["env_unknown_sub"] = "Unbekannter env Unterbefehl:"
    trans["file_not_exists"] = "Datei existiert nicht:"
    trans["env_missing_fields"] = "Fehlende erforderliche Felder name oder image in der Konfigurationsdatei"
    trans["env_creating"] = "Erstelle Umgebung"
    trans["env_created"] = "Umgebung wurde erfolgreich erstellt!"
    trans["env_removed"] = "Umgebung wurde entfernt."
    trans["env_list"] = "Liste aller Hacker env Umgebungen:"
    trans["env_subcommands"] = "Env Unterbefehle:"
    trans["env_create_desc"] = "Neue Umgebung aus Datei erstellen"
    trans["env_remove_desc"] = "Umgebung entfernen"
    trans["env_enter_desc"] = "Umgebung betreten (mit gemounteten Tools)"
    trans["env_docs_desc"] = "Vollständiges Tutorial + Beispiele"
    trans["env_settings_desc"] = "Alle Umgebungen auflisten"
    trans["env_docs"] = `
    %s=== Hacker env – vollständiges Tutorial ===%s
    1. Erstelle eine Konfigurationsdatei (z.B. pentest.hk):
    [env]
    -> name => pentest-env
    -> image => fedora:latest
    -> shell => zsh
    [packages]
    -> -> nmap
    -> -> metasploit-framework
    -> -> burpsuite
    [sync_configs]
    -> -> ~/.zshrc
    -> -> ~/.config/nvim
    [sync_tools]
    -> snap => ["code"]
    -> flatpak => ["com.brave.Browser"]
    -> system => ["~/go/bin/gf"]
    2. Erstelle Umgebung:
    hacker env create ./pentest.hk
    3. Betrete:
    hacker env enter pentest-env
    4. Entferne:
    hacker env remove pentest-env
    Alle Umgebungen sind normale podman Container – du kannst distrobox enter / podman exec normal verwenden.
    `
    // Tłumaczenia z main
    trans["usage_install"] = "Verwendung: hacker install <paket>"
    trans["usage_remove"] = "Verwendung: hacker remove <paket>"
    trans["usage_flatpak_install"] = "Verwendung: hacker flatpak-install <paket>"
    trans["usage_flatpak_remove"] = "Verwendung: hacker flatpak-remove <paket>"
    trans["usage_enter"] = "Verwendung: hacker enter <container>"
    trans["usage_remove_container"] = "Verwendung: hacker remove-container <container>"
    trans["usage_restart"] = "Verwendung: hacker restart <dienst>"
    trans["how_to_create1"] = "Um einen benutzerdefinierten Befehl zu erstellen:"
    trans["how_to_create2"] = "Erstelle eine Datei {befehlsname}.hacker in ~/.config/hackeros/hacker/custom-commands/"
    trans["how_to_create3"] = "Eine Beispiel-Datei für einen benutzerdefinierten Befehl findest du unter: <https://github.com/HackerOS-Linux-System/Hacker-CLI-Tool/blob/main/hacker/config-files/custom-commands/example.hacker>"
    trans["version_tool"] = "Neueste Version des Hacker-Tools: 2.3"
    trans["version_os"] = "Neueste Version von HackerOS: 4.4"
    trans["file_not_found"] = "Datei nicht gefunden:"
    trans["variant_not_found"] = "Variante nicht in der Datei gefunden."
    trans["no_exec_custom"] = "Kein 'exec' in der benutzerdefinierten Befehlsdatei."
    trans["error_custom"] = "Fehler beim Verarbeiten des benutzerdefinierten Befehls:"
    trans["unknown_command"] = "Unbekannter Befehl:"
    trans["system_subcommands"] = "System Unterbefehle:"
    trans["logs_desc"] = "Systemprotokolle anzeigen"
    trans["unknown_system"] = "Unbekannter system Unterbefehl:"
    trans["unknown_update_flag"] = "Unbekannte Flagge für update:"
    trans["available_flags"] = "Verfügbare Flags: --with-gui"
    trans["tools_index"] = "Index der HackerOS-Tools:"
    trans["tool_bytes"] = "Paketmanager für die Programmiersprache hacker"
    trans["tool_hl"] = "Tool zum Kompilieren oder Ausführen von Dateien/Skripten mit der Erweiterung .hacker"
    trans["tool_hli"] = "Tool für große Projekte in der Sprache hacker"
    trans["tool_hacker"] = "Haupt-CLI-Tool von HackerOS"
    trans["tool_kernel"] = "Kernel von HackerOS; wenn du entwickeln möchtest, kontaktiere uns unter: gmail - <hackeros068@gmail.com> oder <https://github.com/orgs/HackerOS-Linux-System/discussions>"
