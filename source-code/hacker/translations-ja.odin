    trans["plugins"] = "プラグイン:"
    trans["enabled"] = "有効"
    trans["disabled"] = "無効"
    trans["invalid"] = "無効"
    trans["usage_plugin_enable"] = "使用方法: hacker plugin enable <プラグイン名>"
    trans["plugin_not_found"] = "プラグインが見つかりません:"
    trans["enabled_plugin"] = "プラグインを有効にしました"
    trans["usage_plugin_disable"] = "使用方法: hacker plugin disable <プラグイン名>"
