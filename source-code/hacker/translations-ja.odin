    trans["tool_steam"] = "Steam 用コンテナ"
    trans["tool_welcome"] = "HackerOS ウェルカムアプリ"
    trans["tool_app"] = "スマートフォン向け HackerOS アプリ"
    trans["tool_hacker_mode"] = "steamos gamemode に着想を得たゲームモード"
    trans["tool_isolator"] = "podman コンテナ内でリポジトリからパッケージをインストールする CLI ツール"
