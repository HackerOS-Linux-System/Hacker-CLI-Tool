package hackeros

ja_translations :: proc() -> map[string]string {
    trans: map[string]string
    // env からの翻訳
    trans["env_create_usage"] = "使用方法: hacker env create <ファイル.hk|ファイル.yaml>"
    trans["env_remove_usage"] = "使用方法: hacker env remove <名前>"
    trans["env_unknown_sub"] = "不明な env サブコマンド:"
    trans["file_not_exists"] = "ファイルが存在しません:"
    trans["env_missing_fields"] = "設定ファイルに必須フィールド name または image がありません"
    trans["env_creating"] = "環境を作成中"
    trans["env_created"] = "環境が正常に作成されました!"
    trans["env_removed"] = "環境が削除されました。"
    trans["env_list"] = "すべての Hacker env 環境のリスト:"
    trans["env_subcommands"] = "env サブコマンド:"
    trans["env_create_desc"] = "ファイルから新しい環境を作成"
    trans["env_remove_desc"] = "環境を削除"
    trans["env_enter_desc"] = "環境に入る（ツールがマウントされます）"
    trans["env_docs_desc"] = "完全なチュートリアル + 例"
    trans["env_settings_desc"] = "すべての環境を一覧表示"
    trans["env_docs"] = `
    %s=== Hacker env – 完全なチュートリアル ===%s
    1. 設定ファイルを作成します（例: pentest.hk）:
    [env]
    -> name => pentest-env
    -> image => fedora:latest
    -> shell => zsh
    [packages]
    -> -> nmap
    -> -> metasploit-framework
    -> -> burpsuite
    [sync_configs]
    -> -> ~/.zshrc
    -> -> ~/.config/nvim
    [sync_tools]
    -> snap => ["code"]
    -> flatpak => ["com.brave.Browser"]
    -> system => ["~/go/bin/gf"]
    2. 環境を作成:
    hacker env create ./pentest.hk
    3. 環境に入る:
    hacker env enter pentest-env
    4. 削除:
    hacker env remove pentest-env
    すべての環境は通常の podman コンテナです。 distrobox enter / podman exec を通常通り使用できます。
    `
    // main からの翻訳
    trans["usage_install"] = "使用方法: hacker install <パッケージ>"
    trans["usage_remove"] = "使用方法: hacker remove <パッケージ>"
    trans["usage_flatpak_install"] = "使用方法: hacker flatpak-install <パッケージ>"
    trans["usage_flatpak_remove"] = "使用方法: hacker flatpak-remove <パッケージ>"
    trans["usage_enter"] = "使用方法: hacker enter <コンテナ>"
    trans["usage_remove_container"] = "使用方法: hacker remove-container <コンテナ>"
    trans["usage_restart"] = "使用方法: hacker restart <サービス>"
    trans["how_to_create1"] = "カスタムコマンドを作成するには:"
    trans["how_to_create2"] = "~/.config/hackeros/hacker/custom-commands/ に {コマンド名}.hacker ファイルを作成します"
    trans["how_to_create3"] = "サンプルのカスタムコマンドファイルはこちらにあります: <https://github.com/HackerOS-Linux-System/Hacker-CLI-Tool/blob/main/hacker/config-files/custom-commands/example.hacker>"
    trans["version_tool"] = "hacker ツールの最新バージョン: 2.3.1"
    trans["version_os"] = "HackerOS の最新バージョン: 4.5"
    trans["file_not_found"] = "ファイルが見つかりません:"
    trans["variant_not_found"] = "ファイルにバリアントが見つかりません。"
    trans["no_exec_custom"] = "カスタムコマンドファイルに 'exec' がありません。"
    trans["error_custom"] = "カスタムコマンドの処理中にエラーが発生しました:"
    trans["unknown_command"] = "不明なコマンド:"
    trans["system_subcommands"] = "system サブコマンド:"
    trans["logs_desc"] = "システムログを表示"
    trans["unknown_system"] = "不明な system サブコマンド:"
    trans["unknown_update_flag"] = "update の不明なフラグ:"
    trans["available_flags"] = "利用可能なフラグ: --with-gui"
    trans["tools_index"] = "HackerOS ツールインデックス:"
    trans["tool_bit"] = "HackerScript 用パッケージマネージャ - より高度"
    trans["tool_virus"] = "HackerScript 用パッケージマネージャ"
    trans["tool_bytes"] = "Hacker Lang 用パッケージマネージャ"
