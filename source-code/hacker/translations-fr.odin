package hackeros

fr_translations :: proc() -> map[string]string {
    trans: map[string]string
    // Traductions de env
    trans["env_create_usage"] = "Utilisation : hacker env create <fichier.hk|fichier.yaml>"
    trans["env_remove_usage"] = "Utilisation : hacker env remove <nom>"
    trans["env_unknown_sub"] = "Sous-commande env inconnue :"
    trans["file_not_exists"] = "Le fichier n'existe pas :"
    trans["env_missing_fields"] = "Champs requis name ou image manquants dans le fichier de configuration"
    trans["env_creating"] = "Création de l'environnement"
    trans["env_created"] = "Environnement créé avec succès !"
    trans["env_removed"] = "L'environnement a été supprimé."
    trans["env_list"] = "Liste de tous les environnements Hacker env :"
    trans["env_subcommands"] = "Sous-commandes env :"
    trans["env_create_desc"] = "Créer un nouvel environnement à partir d'un fichier"
    trans["env_remove_desc"] = "Supprimer l'environnement"
    trans["env_enter_desc"] = "Entrer dans l'environnement (avec outils montés)"
    trans["env_docs_desc"] = "Tutoriel complet + exemples"
    trans["env_settings_desc"] = "Liste de tous les environnements"
    trans["env_docs"] = `
%s=== Hacker env – tutoriel complet ===%s
1. Créez un fichier de configuration (par exemple, pentest.hk) :
[env]
-> name => pentest-env
-> image => fedora:latest
-> shell => zsh
[packages]
-> -> nmap
-> -> metasploit-framework
-> -> burpsuite
[sync_configs]
-> -> ~/.zshrc
-> -> ~/.config/nvim
[sync_tools]
-> snap => ["code"]
-> flatpak => ["com.brave.Browser"]
-> system => ["~/go/bin/gf"]
2. Créez l'environnement :
hacker env create ./pentest.hk
3. Entrez :
hacker env enter pentest-env
4. Supprimez :
hacker env remove pentest-env
Tous les environnements sont des conteneurs podman normaux – vous pouvez utiliser distrobox enter / podman exec normalement.
`
    // Traductions de main
    trans["usage_install"] = "Utilisation : hacker install <paquet>"
    trans["usage_remove"] = "Utilisation : hacker remove <paquet>"
    trans["usage_flatpak_install"] = "Utilisation : hacker flatpak-install <paquet>"
    trans["usage_flatpak_remove"] = "Utilisation : hacker flatpak-remove <paquet>"
    trans["usage_enter"] = "Utilisation : hacker enter <conteneur>"
    trans["usage_remove_container"] = "Utilisation : hacker remove-container <conteneur>"
    trans["usage_restart"] = "Utilisation : hacker restart <service>"
    trans["how_to_create1"] = "Pour créer une commande personnalisée :"
    trans["how_to_create2"] = "Créez un fichier {nom-commande}.hacker dans ~/.config/hackeros/hacker/custom-commands/"
    trans["how_to_create3"] = "Un exemple de fichier de commande personnalisée se trouve à : <https://github.com/HackerOS-Linux-System/Hacker-CLI-Tool/blob/main/hacker/config-files/custom-commands/example.hacker>"
    trans["version_tool"] = "Dernière version de l'outil hacker : 2.3"
    trans["version_os"] = "Dernière version de HackerOS : 4.4"
    trans["file_not_found"] = "Fichier non trouvé :"
    trans["variant_not_found"] = "Variante non trouvée dans le fichier."
    trans["no_exec_custom"] = "Aucun 'exec' dans le fichier de commande personnalisée."
