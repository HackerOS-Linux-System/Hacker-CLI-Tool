package hackeros

ko_translations :: proc() -> map[string]string {
    trans: map[string]string
    // env 번역
    trans["env_create_usage"] = "사용법: hacker env create <파일.hk|파일.yaml>"
    trans["env_remove_usage"] = "사용법: hacker env remove <이름>"
    trans["env_unknown_sub"] = "알 수 없는 env 하위 명령:"
    trans["file_not_exists"] = "파일이 존재하지 않습니다:"
    trans["env_missing_fields"] = "구성 파일에 필수 필드 name 또는 image가 없습니다"
    trans["env_creating"] = "환경 생성 중"
    trans["env_created"] = "환경이 성공적으로 생성되었습니다!"
    trans["env_removed"] = "환경이 제거되었습니다."
    trans["env_list"] = "모든 Hacker env 환경 목록:"
    trans["env_subcommands"] = "env 하위 명령:"
    trans["env_create_desc"] = "파일에서 새 환경 생성"
    trans["env_remove_desc"] = "환경 제거"
    trans["env_enter_desc"] = "환경에 들어가기 (도구가 마운트됨)"
    trans["env_docs_desc"] = "전체 튜토리얼 + 예제"
    trans["env_settings_desc"] = "모든 환경 나열"
    trans["env_docs"] = `
    %s=== Hacker env – 전체 튜토리얼 ===%s
    1. 구성 파일을 만듭니다 (예: pentest.hk):
    [env]
    -> name => pentest-env
    -> image => fedora:latest
    -> shell => zsh
    [packages]
    -> -> nmap
    -> -> metasploit-framework
    -> -> burpsuite
    [sync_configs]
    -> -> ~/.zshrc
    -> -> ~/.config/nvim
    [sync_tools]
    -> snap => ["code"]
    -> flatpak => ["com.brave.Browser"]
    -> system => ["~/go/bin/gf"]
    2. 환경 생성:
    hacker env create ./pentest.hk
    3. 들어가기:
    hacker env enter pentest-env
    4. 제거:
    hacker env remove pentest-env
    모든 환경은 일반적인 podman 컨테이너입니다. distrobox enter / podman exec를 평소처럼 사용할 수 있습니다.
    `
    // main 번역
    trans["usage_install"] = "사용법: hacker install <패키지>"
    trans["usage_remove"] = "사용법: hacker remove <패키지>"
