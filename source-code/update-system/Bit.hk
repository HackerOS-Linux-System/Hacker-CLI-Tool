[package]
-> name        => update-system
-> version     => 2.4.3
-> description => "System updater for HackerOS"
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => GPL-3.0
-> lang        => h#

[layout]
-> src => src

[build]
-> link => static

[default-build]
-> profile => release

[commands]
-> check
--> run => find src -name '*.h#' -print0 | xargs -0 h# check
--> description => Type-check every module
