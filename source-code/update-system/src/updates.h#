pub fn update_hnm() -> bool is
    ui::banner("HackerOS Nix Manager · hnm")

    ui::step("Checking Nix installation…")
    let (check_ok, check_out) = sudo::capture_command("hnm check 2>&1")

    if check_out.contains("not found") && !check_ok is
        ui::warn_msg("hnm command not found — skipping Nix section")
        return false
    end

    let nix_found: bool = check_out.contains("✓ nix") && !check_out.contains("NOT FOUND")

    if !nix_found is
        ui::warn_msg("Nix not installed — running `hnm unpack`")
        let unpack_ok: bool = sudo::run_command("hnm unpack")
        if !unpack_ok is
            ui::fail_msg("hnm unpack failed — skipping update & upgrade")
            return false
        end
        ui::ok("hnm unpack completed")
    else is
        ui::ok("Nix installation verified")
        let out_lines: [string] = str::split(check_out, "\n")
        let mut li: int = 0
        while li < out_lines.len() is
            write("     " + ui::dark_gray(out_lines[li]))
            li += 1
        end
    end

    ui::step("Running hnm update")
    let update_ok: bool = sudo::run_command("hnm update")
    if !update_ok is ui::fail_msg("hnm update failed") end

    ui::step("Running hnm upgrade")
    let upgrade_ok: bool = sudo::run_command("hnm upgrade")
    if !upgrade_ok is ui::fail_msg("hnm upgrade failed") end

    return update_ok && upgrade_ok
end

