pub fn update_apt() -> bool is
    ui::banner("System Update · APT")
    let mut success: bool = true

    ui::step("Refreshing package lists")
    if !sudo::sudo_run("apt update") is success = false end

    ui::step("Upgrading packages")
    if !sudo::sudo_run("apt upgrade -y") is success = false end

    ui::step("Cleaning cache")
    if !sudo::sudo_run("apt autoclean") is success = false end

    return success
end

