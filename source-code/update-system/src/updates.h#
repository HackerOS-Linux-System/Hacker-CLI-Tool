pub fn update_brew() -> bool is
    ui::banner("Homebrew Update")
    let (brew_present, _) = sudo::capture_command("command -v brew")
    let mut brew_installed: bool = brew_present

    if !brew_installed is
        ui::step("Brew not found — installing…")
        let mut install_ok: bool = true

        if !sudo::run_command("NONINTERACTIVE=1 /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"") is
            install_ok = false
        end
        if !sudo::run_command("echo 'eval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)\"' >> ~/.zshrc") is
            install_ok = false
        end
        if !sudo::run_command("eval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)\"") is
            install_ok = false
        end

        if install_ok is
            ui::ok("Brew installed successfully")
            brew_installed = true
        else is
            ui::fail_msg("Brew installation failed")
            return false
        end
    else is
        ui::ok("Brew already installed")
    end

    if !brew_installed is return false end

    let mut success: bool = true
    ui::step("Fetching updates")
    if !sudo::run_command("brew update") is success = false end
    ui::step("Upgrading formulae")
    if !sudo::run_command("brew upgrade") is success = false end
    ui::step("Cleaning up")
    if !sudo::run_command("brew cleanup") is success = false end
    return success
end

